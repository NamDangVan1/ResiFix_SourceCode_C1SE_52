generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                 @id @default(uuid())
  phone                    String                 @unique
  email                    String?                @unique
  passwordHash             String
  fullName                 String
  avatarUrl                String?
  role                     Role                   @default(RESIDENT)
  isActive                 Boolean                @default(true)
  apartmentCode            String?
  buildingBlock            String?
  floorNumber              Int?
  specialty                IncidentCategory?
  specialtyLabel           String?
  shiftName                String?
  isOnDuty                 Boolean                @default(false)
  fcmToken                 String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  isActivated              Boolean                @default(true)
  tokenVersion             Int                    @default(0)
  mustChangePassword       Boolean                @default(false)
  attendances              AttendanceLog[]        @relation("TechnicianAttendance")
  assignedTickets          IncidentTicket[]       @relation("TechnicianTickets")
  approvedTickets          IncidentTicket[]       @relation("BmbApprovedTickets")
  reportedTickets          IncidentTicket[]       @relation("ResidentTickets")
  lockedPayrolls           MonthlyPayrollLock[]
  notifications            Notification[]
  reviewedOvertimes        OvertimeRequest[]      @relation("BmbOvertimeReview")
  overtimes                OvertimeRequest[]      @relation("TechnicianOvertime")
  proposedCosts            RepairMaterialCost[]   @relation("ProposedCosts")
  reviewedCosts            RepairMaterialCost[]   @relation("ReviewedCosts")
  residencies              ResidencyRecord[]
  reviewedScheduleRequests ShiftScheduleRequest[] @relation("BmbScheduleReviews")
  receivedSwapRequests     ShiftScheduleRequest[] @relation("TargetTechSwapRequests")
  scheduleRequests         ShiftScheduleRequest[] @relation("TechScheduleRequests")
  uploadedMedia            TicketMedia[]
  statusLogs               TicketStatusLog[]

  @@index([role, isOnDuty])
  @@index([apartmentCode])
}

model BuildingArea {
  id            String           @id @default(uuid())
  qrCode        String           @unique
  assetName     String?
  category      IncidentCategory @default(OTHER)
  locationLabel String
  buildingBlock String
  floor         String
  isActive      Boolean          @default(true)
  createdAt     DateTime         @default(now())
  areaName      String
  tickets       IncidentTicket[]

  @@index([qrCode])
}

model IncidentTicket {
  id                  String              @id @default(uuid())
  ticketCode          String              @unique
  title               String
  description         String
  isVoiceInput        Boolean             @default(false)
  locationNote        String
  isQrScannedByRes    Boolean             @default(false)
  aiSummary           String?
  aiSuggestedCategory IncidentCategory?
  aiSuggestedPriority PriorityLevel?
  aiLatencyMs         Int?
  isAiValidJson       Boolean             @default(true)
  isAiFallbackManual  Boolean             @default(false)
  aiRawResponse       Json?
  finalCategory       IncidentCategory?
  finalPriority       PriorityLevel?
  bmbAdminNote        String?
  bmbApprovedById     String?
  assignedAt          DateTime?
  assignedTechId      String?
  acknowledgedAt      DateTime?
  isQrVerifiedByTech  Boolean             @default(false)
  techRepairNote      String?
  completedAt         DateTime?
  status              TicketStatus        @default(PENDING)
  resolvedConfirmedAt DateTime?
  ratingStars         Int?
  ratingComment       String?
  residentId          String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  areaId              String?
  apartmentId         String?
  area                BuildingArea?       @relation(fields: [areaId], references: [id])
  assignedTech        User?               @relation("TechnicianTickets", fields: [assignedTechId], references: [id])
  bmbApprovedBy       User?               @relation("BmbApprovedTickets", fields: [bmbApprovedById], references: [id])
  resident            User                @relation("ResidentTickets", fields: [residentId], references: [id])
  apartment           Apartment?          @relation(fields: [apartmentId], references: [id], onUpdate: NoAction, map: "fk_ticket_apartment")
  notifications       Notification[]
  overtimes           OvertimeRequest[]
  repairCost          RepairMaterialCost?
  slaTracking         SlaTracking?
  media               TicketMedia[]
  statusLogs          TicketStatusLog[]

  @@index([status])
  @@index([residentId, status])
  @@index([assignedTechId, status])
  @@index([ticketCode])
  @@index([apartmentId], map: "idx_ticket_apartment")
}

model TicketMedia {
  id           String         @id @default(uuid())
  ticketId     String
  imageUrl     String
  publicId     String?
  mediaType    MediaType
  caption      String?
  uploadedById String
  createdAt    DateTime       @default(now())
  ticket       IncidentTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])

  @@index([ticketId, mediaType])
}

model TicketStatusLog {
  id          String         @id @default(uuid())
  ticketId    String
  fromStatus  TicketStatus?
  toStatus    TicketStatus
  title       String
  note        String?
  changedById String
  createdAt   DateTime       @default(now())
  changedBy   User           @relation(fields: [changedById], references: [id])
  ticket      IncidentTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  ticketId  String?
  type      NotificationType
  title     String
  message   String
  isRead    Boolean          @default(false)
  fcmSent   Boolean          @default(false)
  createdAt DateTime         @default(now())
  ticket    IncidentTicket?  @relation(fields: [ticketId], references: [id])
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model SystemSetting {
  id        String   @id @default(dbgenerated("gen_random_uuid()"))
  key       String   @unique
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
}

model Apartment {
  id            String            @id @default(dbgenerated("gen_random_uuid()"))
  apartmentCode String            @unique
  buildingBlock String
  floorNumber   Int
  roomQrCode    String            @unique
  status        String            @default("OCCUPIED")
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt
  tickets       IncidentTicket[]
  residencies   ResidencyRecord[]

  @@index([buildingBlock, floorNumber], map: "idx_apartment_block_floor")
}

model ResidencyRecord {
  id               String    @id @default(dbgenerated("gen_random_uuid()"))
  residentId       String?
  residentName     String
  residentPhone    String
  apartmentId      String
  apartmentCode    String
  buildingBlock    String
  floorNumber      Int
  moveInDate       DateTime  @default(now())
  moveOutDate      DateTime?
  isRepresentative Boolean   @default(false)
  createdAt        DateTime  @default(now())
  residencyRole    String    @default("TENANT")
  apartment        Apartment @relation(fields: [apartmentId], references: [id], onUpdate: NoAction, map: "fk_residency_apartment")
  resident         User?     @relation(fields: [residentId], references: [id], onUpdate: NoAction, map: "fk_residency_user")

  @@index([apartmentId], map: "idx_residency_apartment")
  @@index([residentId], map: "idx_residency_resident")
}

model AttendanceLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  technicianId   String
  technicianName String
  date           String
  sessionIndex   Int       @default(1)
  checkIn        DateTime
  checkOut       DateTime?
  workMinutes    Int?
  workHours      Decimal?  @db.Decimal(5, 2)
  shiftScheduled String?
  anomalyNotes   String?
  createdAt      DateTime  @default(now())
  technician     User      @relation("TechnicianAttendance", fields: [technicianId], references: [id], onUpdate: NoAction, map: "fk_attendance_tech")

  @@unique([technicianId, date, sessionIndex], map: "uq_attendance_tech_date_session")
  @@index([technicianId, date], map: "idx_attendance_tech_date")
}

model OvertimeRequest {
  id              String          @id @default(dbgenerated("gen_random_uuid()"))
  technicianId    String
  technicianName  String
  ticketId        String?
  ticketCode      String?
  date            String
  fromTime        String
  toTime          String
  durationMinutes Int
  requestedHours  Decimal         @db.Decimal(4, 2)
  approvedHours   Decimal?        @db.Decimal(4, 2)
  reason          String
  status          String          @default("PENDING")
  reviewNote      String?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  reviewedBy      User?           @relation("BmbOvertimeReview", fields: [reviewedById], references: [id], onUpdate: NoAction, map: "fk_ot_reviewer")
  technician      User            @relation("TechnicianOvertime", fields: [technicianId], references: [id], onUpdate: NoAction, map: "fk_ot_tech")
  ticket          IncidentTicket? @relation(fields: [ticketId], references: [id], onUpdate: NoAction, map: "fk_ot_ticket")

  @@index([technicianId, date], map: "idx_ot_tech_date")
}

model MonthlyPayrollLock {
  id           String   @id @default(dbgenerated("gen_random_uuid()"))
  month        String   @unique
  totalPayout  BigInt
  lockedById   String?
  lockedByName String
  lockedAt     DateTime @default(now())
  auditNote    String?
  lockedBy     User?    @relation(fields: [lockedById], references: [id], onUpdate: NoAction, map: "fk_payroll_lock_user")
}

model ShiftScheduleRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()"))
  type           String
  techId         String
  techName       String
  date           String
  endDate        String?
  leaveType      String?
  shiftName      String?
  targetTechId   String?
  targetTechName String?
  reason         String
  status         String    @default("PENDING")
  reviewNote     String?
  reviewedById   String?
  reviewedByName String?
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  reviewedBy     User?     @relation("BmbScheduleReviews", fields: [reviewedById], references: [id], onUpdate: NoAction, map: "fk_sched_reviewer")
  targetTech     User?     @relation("TargetTechSwapRequests", fields: [targetTechId], references: [id], onUpdate: NoAction, map: "fk_sched_target_tech")
  tech           User      @relation("TechScheduleRequests", fields: [techId], references: [id], onUpdate: NoAction, map: "fk_sched_tech")

  @@index([techId, date], map: "idx_sched_tech_date")
}

model RepairMaterialCost {
  id              String         @id @default(dbgenerated("gen_random_uuid()"))
  ticketId        String         @unique
  ticketCode      String
  proposedById    String
  proposedByName  String
  status          String         @default("DRAFT")
  otherCost       BigInt         @default(0)
  totalCost       BigInt
  receiptProofUrl String?
  reviewNote      String?
  reviewedById    String?
  reviewedByName  String?
  reviewedAt      DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @default(now()) @updatedAt
  items           MaterialItem[]
  proposedBy      User           @relation("ProposedCosts", fields: [proposedById], references: [id], onUpdate: NoAction, map: "fk_cost_proposer")
  reviewedBy      User?          @relation("ReviewedCosts", fields: [reviewedById], references: [id], onUpdate: NoAction, map: "fk_cost_reviewer")
  ticket          IncidentTicket @relation(fields: [ticketId], references: [id], onUpdate: NoAction, map: "fk_cost_ticket")
}

model MaterialItem {
  id           String             @id @default(dbgenerated("gen_random_uuid()"))
  costId       String
  materialCode String
  materialName String
  unit         String
  quantity     Int
  unitPrice    BigInt
  totalPrice   BigInt
  notes        String?
  cost         RepairMaterialCost @relation(fields: [costId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_item_cost")

  @@index([costId], map: "idx_material_cost")
}

model SlaTracking {
  id                 String         @id @default(dbgenerated("gen_random_uuid()"))
  ticketId           String         @unique
  ticketCode         String
  priority           String
  status             String
  responseDeadline   DateTime
  assignmentDeadline DateTime
  resolutionDeadline DateTime
  slaStatus          String         @default("ON_TRACK")
  isPaused           Boolean        @default(false)
  pauseReason        String?
  pausedAt           DateTime?
  escalationTier     Int            @default(0)
  lastAlertSentAt    DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @default(now()) @updatedAt
  ticket             IncidentTicket @relation(fields: [ticketId], references: [id], onUpdate: NoAction, map: "fk_sla_ticket")

  @@index([slaStatus, escalationTier], map: "idx_sla_status_tier")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otpHash   String
  purpose   String
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

enum Role {
  RESIDENT
  TECHNICIAN
  BMB
}

enum TicketStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CLOSED
}

enum PriorityLevel {
  LOW
  MEDIUM
  HIGH
}

enum IncidentCategory {
  PLUMBING
  ELECTRICAL
  ELEVATOR
  HVAC
  ACCESS_SECURITY
  OTHER
}

enum MediaType {
  SCENE_BEFORE
  REPAIR_PROOF
}

enum NotificationType {
  NEW_INCIDENT_AI
  AI_TIMEOUT_ALERT
  TASK_ASSIGNED
  STATUS_UPDATED
  TICKET_CLOSED
}
