{
  "expo": {
    "name": "ResiFix",
    "slug": "client",
    "version": "1.0.0",
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.c1se52.resifix"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ResiFix truy cập Camera để quét mã QR và chụp ảnh hiện trường."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép ResiFix truy cập Thư viện ảnh để đính kèm minh chứng sự cố."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "049a9acd-2a32-4854-81d8-890cad3eea9c"
      }
    },
    "owner": "namdangvans-team"
  }
}
